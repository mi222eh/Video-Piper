{
  "tasks": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "serve": "deno run --allow-net --allow-read --allow-run server.ts",
    "desktop": "deno desktop --allow-net --allow-read --allow-run server.ts",
    "compile": "deno compile --allow-net --allow-read --allow-run --output bin/video-piper server.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx"
  }
}
