<Application x:Class="VideoPiper.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:models="using:VideoPiper.Models"
       xmlns:services="using:VideoPiper.Services"
       xmlns:converters="using:VideoPiper.Converters">
    <Application.Resources>
        <!--
            Semantic design tokens (Video Piper).
            Single source of truth for state colors so dark/light themes stay consistent.
            Alpha: 0x22 ≈ 13% fill, 0x66 ≈ 40% stroke.
        -->
        <Color x:Key="VpSuccessColor">#FF22C55E</Color>
        <Color x:Key="VpWarningColor">#FFEAB308</Color>
        <Color x:Key="VpErrorColor">#FFEF4444</Color>

        <SolidColorBrush x:Key="VpSuccessBrush" Color="{StaticResource VpSuccessColor}"/>
        <SolidColorBrush x:Key="VpWarningBrush" Color="{StaticResource VpWarningColor}"/>
        <SolidColorBrush x:Key="VpErrorBrush" Color="{StaticResource VpErrorColor}"/>

        <SolidColorBrush x:Key="VpSuccessBgBrush" Color="#2222C55E"/>
        <SolidColorBrush x:Key="VpSuccessBorderBrush" Color="#6622C55E"/>
        <SolidColorBrush x:Key="VpWarningBgBrush" Color="#22EAB308"/>
        <SolidColorBrush x:Key="VpWarningBorderBrush" Color="#66EAB308"/>
        <SolidColorBrush x:Key="VpErrorBgBrush" Color="#22EF4444"/>
        <SolidColorBrush x:Key="VpErrorBorderBrush" Color="#66EF4444"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrush"/>


        <DataTemplate x:Key="LibraryItemTemplate">
            <Border Margin="0,3,0,3" Padding="12,10,12,10" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon box -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <FontIcon FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Glyph="{Binding IconGlyph}"/>
                    </Border>

                    <!-- Details & Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ProgressBar Height="4" Maximum="100" CornerRadius="2"
                                     Value="{Binding Percent, FallbackValue=0}"
                                     IsIndeterminate="{Binding IsIndeterminate, FallbackValue=False}"
                                     Visibility="{Binding ProgressVisibility, FallbackValue=Collapsed}"/>
                    </StackPanel>

                    <!-- Badge -->
                    <Border Grid.Column="2" Padding="6,2,6,2" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate">
            <Border Margin="0,3,0,3" Padding="12,10,12,10" CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail / Video icon placeholder -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <FontIcon FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  Glyph="&#xE714;"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MetaText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Chevron: clicking the row opens the video info page (no download) -->
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One row in the download queue: status glyph, title, status text, live progress, format badge. -->
        <DataTemplate x:Key="QueueEntryTemplate">
            <Border Margin="0,2,0,2" Padding="10,8,10,8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status glyph -->
                    <FontIcon Grid.Column="0" FontSize="13"
                              VerticalAlignment="Center"
                              Glyph="{Binding StatusGlyph}"
                              Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>

                    <!-- Title + status + per-item progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <!-- Determinate bar: the percent IS the value (IsIndeterminate is only
                             true before the first tick, so it matches the main list row and the progress card). -->
                        <ProgressBar Height="3" Maximum="100" CornerRadius="2"
                                     Value="{Binding Percent, FallbackValue=0}"
                                     IsIndeterminate="{Binding IsIndeterminate, FallbackValue=False}"
                                     Visibility="{Binding IsDownloading, FallbackValue=False, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Format badge -->
                    <Border Grid.Column="2" Padding="6,2,6,2" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Application.Resources>
</Application>
