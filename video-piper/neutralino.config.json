{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.videopiper.app",
  "version": "0.1.0",
  "defaultMode": "window",
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "os.*",
    "events.*",
    "clipboard.*",
    "window.*",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "Video Piper",
      "width": 680,
      "height": 580,
      "minWidth": 500,
      "minHeight": 450,
      "resizable": true,
      "maximize": false
    }
  },
  "cli": {
    "binaryName": "video-piper",
    "resourcesPath": "/dist/",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "projectPath": "/",
      "devUrl": "http://localhost:1420",
      "devCommand": "pnpm dev",
      "buildCommand": "pnpm build"
    },
    "binaryVersion": "6.9.0"
  }
}